PORT=3000
MONGO_URI=your-mongodb-connection-string-here
JWT_SECRET=secret-key
JWT_REFRESH_SECRET=another-secret-key

# frontend origin — used to build links in verification/reset emails
CLIENT_URL=http://localhost:5173

# SMTP — leave SMTP_HOST unset to log emails to the console instead of
# sending them (fine for local dev). Example values for Gmail SMTP,
# Mailtrap, etc. go here once you have real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CoWork <no-reply@cowork.local>
