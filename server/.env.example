PORT=3000
MONGO_URI=your-mongodb-connection-string-here
JWT_SECRET=secret-key
JWT_REFRESH_SECRET=another-secret-key

# frontend origin — used to build links in verification/reset emails
CLIENT_URL=http://localhost:5173

# Resend (https://resend.com) — sends over HTTPS, not SMTP, so it isn't
# affected by hosts that block/hang outbound SMTP ports (e.g. Render free
# tier). Leave RESEND_API_KEY unset to log emails to the console instead of
# sending them (fine for local dev). Sign up at resend.com, verify a sending
# domain (or use their onboarding@resend.dev for testing), then create an
# API key under API Keys in the dashboard.
RESEND_API_KEY=
MAIL_FROM=CoWork <no-reply@cowork.local>
